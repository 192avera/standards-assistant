{
  "permissions": {
    "allow": [
      "Bash(uv run ruff check .)",
      "Bash(uv run ruff check . --fix)",
      "Bash(uv run ruff format .)",
      "Bash(uv run ruff format . --check)",
      "Bash(uv run pytest*)",
      "Bash(uv run python*)",
      "Bash(git status)",
      "Bash(git remote -v)",
      "Bash(git remote add origin*)",
      "Bash(git init)",
      "Bash(git diff --name-only*)",
      "Bash(git diff --stat*)",
      "Bash(git merge-base*)",
      "Bash(git rev-parse*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(uv run ruff check --output-format=json*)",
      "Bash(ssh -T git@bitbucket.org)",
      "Bash(bash .claude/check-updates.sh)",
      "Bash(bash .claude/check-updates.sh --update)",
      "Read(*)"
    ]
  },
  "mcpServers": {
    "atlassian": {
      "type": "sse",
      "url": "https://mcp.atlassian.com/v1/sse"
    }
  }
}
